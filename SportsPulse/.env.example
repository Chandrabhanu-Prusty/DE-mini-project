# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Directory Configuration (relative to project root)
DATA_BRONZE_DIR=data/bronze/ipl
DATA_SILVER_DIR=data/silver
DATA_GOLD_DIR=data/gold
DATA_QUARANTINE_DIR=data/quarantine
LOG_DIR=logs
REPORT_DIR=reports

# PostgreSQL Analytical Warehouse (Local Windows Host Execution)
# Replace USERNAME and PASSWORD with your local PostgreSQL credentials
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/sportspulse

# PostgreSQL Analytical Warehouse (Docker Airflow Container Execution)
# When Airflow runs inside Docker, localhost refers to the container.
# Use host.docker.internal to route requests back to your Windows host PostgreSQL instance.
DATABASE_URL_DOCKER=postgresql+psycopg2://USERNAME:PASSWORD@host.docker.internal:5432/sportspulse
